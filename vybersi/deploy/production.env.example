APP_NAME="Vyber si"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://vybersi.rulc.eu
APP_LOCALE=cs
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=7

DB_CONNECTION=pgsql
DB_HOST=/var/run/postgresql
DB_PORT=5432
DB_DATABASE=vybersi
DB_USERNAME=vybersi

SESSION_DRIVER=database
SESSION_ENCRYPT=true
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=sync
